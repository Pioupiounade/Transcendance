# Copier ce fichier vers `.env` (ignoré par git) et adapter les valeurs.

# Base URL de l'API vue par le navigateur.
# En dev : `/api`, réécrit par le proxy Vite vers le backend (CORS non activé côté NestJS).
# En prod (Nginx) : l'URL publique du backend, ex. `https://pioupiounades.fr/api`.
VITE_API_URL=/api

# Cible du proxy Vite en dev (le backend n'a ni préfixe ni version).
# Poste local : http://localhost:3000 · conteneur Docker : http://backend:3000
VITE_DEV_PROXY_TARGET=http://localhost:3000
