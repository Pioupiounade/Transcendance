// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

// Le generateur detemine quels assets seront generes lors de l'execution de la commande `prisma generate`
generator client {
  // generateur a utiliser pour creer le client Prisma. Ici le generateur officiel.
  provider     = "prisma-client"
  // le chemin vers le dossier dans lequel Prisme sera genere.
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  // le connecteur vers la bdd
  provider = "postgresql"
}

// Modeles de donnees = une table

// --------------------------------------------------
// USERS
// --------------------------------------------------

model User {
  // 1. Champs réellement stockés en base
  user_id        BigInt        @id @default(autoincrement())
  email          String        @unique
  password_hash  String
  role           RoleApp       @default(USER)
  account_status AccountStatus @default(ACTIVE)
  points         Int           @default(0)
  created_at     DateTime      @default(now())
  updated_at     DateTime      @updatedAt
  refresh_token  String?

  // 2. Champs de relation Prisma
  profile Profile?

  actions     Action[] @relation("ActionCreator")
  validations Action[] @relation("ActionValidator")

  Participations Participation[]

  organization_members  OrganizationMember[]
  created_organizations Organization[]       @relation("OrganizationCreator")
  interests             UserInterest[]

  sent_friend_requests     FriendRequest[] @relation("FriendRequestRequester")
  received_friend_requests FriendRequest[] @relation("FriendRequestAddressee")

  friendships_as_user1 Friendship[] @relation("FriendshipUser1")
  friendships_as_user2 Friendship[] @relation("FriendshipUser2")

  blocked_friendships Friendship[] @relation("FriendshipBlocker")

  point_transactions PointTransaction[]

  comments ActionComment[]

  organization_comments OrganizationComment[]
}

// --------------------------------------------------
// PROFILE
// --------------------------------------------------

model Profile {
  // 1. Champs réellement stockés en base
  user_id         BigInt            @id
  username        String            @unique
  description     String?
  profile_picture String?
  location        Float[]
  commune         String?
  visibility      ProfileVisibility @default(PUBLIC)

  // 2. Champs de relation Prisma
  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
}

// --------------------------------------------------
// INTERESTS
// --------------------------------------------------

model UserInterest {
  user_id  BigInt
  interest InterestCategory

  user User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@id([user_id, interest])
}

// --------------------------------------------------
// ORGANIZATION
// --------------------------------------------------

model Organization {
  // 1. Champs réellement stockés en base
  organization_id     BigInt             @id @default(autoincrement())
  title               String
  description         String
  organization_status OrganizationStatus @default(ACTIVE)

  address  String
  location Float[]

  creator_id BigInt
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // 2. Champs de relation Prisma
  creator User                 @relation("OrganizationCreator", fields: [creator_id], references: [user_id])
  members OrganizationMember[]
  actions Action[]
  comments OrganizationComment[]
}

// --------------------------------------------------
// ORGANIZATION MEMBERS
// --------------------------------------------------

model OrganizationMember {
  // 1. Champs réellement stockés en base
  organization_id BigInt
  user_id         BigInt

  status MemberStatus @default(PENDING)
  role   RoleOrg      @default(MEMBER)

  validated_by_org_man Boolean   @default(false)
  validated_at         DateTime? @default(now())

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // 2. Champs de relation Prisma
  organization Organization @relation(fields: [organization_id], references: [organization_id])

  user User @relation(fields: [user_id], references: [user_id])

  @@id([organization_id, user_id])
}

// --------------------------------------------------
// ACTIONS
// --------------------------------------------------

model Action {
  // 1. Champs réellement stockés en base
  action_id   BigInt @id @default(autoincrement())
  title       String
  description String

  creator_id      BigInt
  organization_id BigInt?

  min_participants Int  @default(3)
  max_participants Int?
  location         Float[]
  status           ActionStatus @default(PENDING)
  category         Category
  images_before    String[] @default([])
  images_after     String[] @default([])

  validated_by_user_id BigInt?
  validated_at         DateTime?

  scheduled_at DateTime

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // 2. Champs de relation Prisma
  creator User @relation("ActionCreator", fields: [creator_id], references: [user_id])

  validator User? @relation("ActionValidator", fields: [validated_by_user_id], references: [user_id])

  organization Organization? @relation(fields: [organization_id], references: [organization_id])

  participation Participation[]

  comments ActionComment[]
}

// --------------------------------------------------
// COMMENTS
// --------------------------------------------------

model ActionComment {
  // Text locked at 1024 characters, to avoid spam
  comment_id BigInt @id @default(autoincrement())
  content    String @db.VarChar(1024)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // 2. Champs de relation Prisma
  user_id    BigInt
  action_id  BigInt

  user       User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  action     Action @relation(fields: [action_id], references: [action_id], onDelete: Cascade)

  @@map("action_comments")
}

model OrganizationComment {
  // Text locked at 1024 characters, to avoid spam
  comment_id BigInt @id @default(autoincrement())
  content    String @db.VarChar(1024)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // 2. Champs de relation Prisma
  user_id         BigInt
  organization_id BigInt

  user           User @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  organization   Organization @relation(fields: [organization_id], references: [organization_id], onDelete: Cascade)

  @@map("organization_comments")
}

// --------------------------------------------------
// PARTICIPATIONS
// --------------------------------------------------

model Participation {
  // 1. Champs réellement stockés en base
  action_id BigInt
  user_id   BigInt

  created_at DateTime @default(now())

  // 2. Champs de relation Prisma
  action Action @relation(fields: [action_id], references: [action_id])
  user   User   @relation(fields: [user_id], references: [user_id])

  @@id([action_id, user_id])
}

// --------------------------------------------------
// FRIENDSHIPS
// --------------------------------------------------

model FriendRequest {
  friend_request_id BigInt @id @default(autoincrement())

  requester_id BigInt
  addressee_id BigInt

  status FriendRequestStatus @default(PENDING)

  created_at   DateTime  @default(now())
  responded_at DateTime?

  requester User @relation("FriendRequestRequester", fields: [requester_id], references: [user_id])
  addressee User @relation("FriendRequestAddressee", fields: [addressee_id], references: [user_id])
}

model Friendship {
  user1_id BigInt
  user2_id BigInt

  status FriendshipStatus @default(ACTIVE)

  blocked_by_user_id BigInt?

  created_at DateTime @default(now())

  user1 User @relation("FriendshipUser1", fields: [user1_id], references: [user_id])
  user2 User @relation("FriendshipUser2", fields: [user2_id], references: [user_id])

  blocked_by User? @relation("FriendshipBlocker", fields: [blocked_by_user_id], references: [user_id])

  @@id([user1_id, user2_id])
}

// --------------------------------------------------
// POINTS
// --------------------------------------------------

model PointTransaction {
  // 1. Champs réellement stockés en base
  point_transaction_id BigInt      @id @default(autoincrement())
  user_id              BigInt
  points               Int
  reason               PointReason
  event_key            String      @unique
  created_at           DateTime    @default(now())

  // 2. Champs de relation Prisma
  user User @relation(fields: [user_id], references: [user_id])
}

// --------------------------------------------------
// ENUMS
// --------------------------------------------------

enum RoleApp {
  USER
  ADMIN
  MODERATOR
}

enum RoleOrg {
  MEMBER
  MANAGER
  OWNER
}

enum ActionStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

enum MemberStatus {
  PENDING
  ACTIVE
  REJECTED
  BANNED
}

enum Category {
  SOCIAL
  ENVIRONMENT
  CULTURAL
}

enum InterestCategory {
  ENV_FLOWER_POWER
  ENV_CLEAN
  ENV_DO

  SOCIAL_SHARE
  SOCIAL_MEET
  SOCIAL_DO

  CULTURAL_LEARN
  CULTURAL_CREATE
  CULTURAL_DO
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum FriendshipStatus {
  ACTIVE
  BLOCKED
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum PointReason {
  ACTION_COMPLETED
  ACTION_PARTICIPATED
  ACTION_PARTICIPANTS

  ORGANIZATION_MEMBER_JOINED
  ORGANIZATION_MEMBER_LEFT
  ORGANIZATION_MEMBER_REMOVED
  ORGANIZATION_MEMBER_BANNED

  USER_SUSPENDED
  USER_BANNED_FROM_ORGANIZATION

  ADMIN_ADJUSTMENT
}

enum PiouPiouStatus {
  PETIT_PIOUPIOU
  GRAND_PIOUPIOU
  PIOUPIOU_OR
}

enum ProfileVisibility {
  PUBLIC
  PRIVATE
  FRIENDS_ONLY
}
