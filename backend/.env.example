# Copy this file to backend/.env (ignored by git) and replace every value.
# Inside Docker, DATABASE_URL is injected by docker-compose.yml from docker/.env; this value is only used
# when the backend runs outside Docker.
DATABASE_URL=postgresql://pioupiounades:change-me@localhost:5432/pioupiounades
# Generate each secret with: openssl rand -hex 32
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me
